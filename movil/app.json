{
  "expo": {
    "name": "Universidad Siglo XXI",
    "slug": "uni-siglo-xxi-alumno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_sigloxxi.jpg",
    "scheme": "movil",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sigloxxi.alumno",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_sigloxxi.jpg",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_sigloxxi.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo_sigloxxi.jpg",
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61b1e02d-aded-494a-9f10-a545d8aecb51"
      }
    }
  }
}
